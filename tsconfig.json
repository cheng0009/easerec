{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@tauri-apps/api/core": ["src/bridge/invoke.ts"],
      "@tauri-apps/api/event": ["src/bridge/event.ts"],
      "@tauri-apps/api/dialog": ["src/bridge/dialog.ts"],
      "@tauri-apps/api/window": ["src/bridge/window.ts"],
      "@tauri-apps/api/webviewWindow": ["src/bridge/webviewWindow.ts"],
      "@tauri-apps/api/webview": ["src/bridge/webviewWindow.ts"],
      "@tauri-apps/plugin-dialog": ["src/bridge/dialog.ts"],
      "@tauri-apps/plugin-shell": ["src/bridge/shell.ts"],
      "@tauri-apps/plugin-global-shortcut": ["src/bridge/globalShortcut.ts"]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["src", "electron", "tests", "vitest.config.ts"]
}